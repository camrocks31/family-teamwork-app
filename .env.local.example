# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both values below are PUBLIC by design: they ship inside the static bundle
# that anyone can read from the published site. The anon key is useless on its
# own — every table has row level security, so it reaches exactly the rows
# policy allows and nothing else.
#
# For the local stack, `npx supabase status` prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service-role key in this file or any NEXT_PUBLIC_ variable.
# It bypasses row level security completely. It belongs only in a server-side
# context — the bootstrap script below, run locally, or an Edge Function's own
# secrets. If it ever reaches the bundle, it is published to the world.
#
# Used only by `npm run bootstrap:parent`, never by the app.
SUPABASE_SERVICE_ROLE_KEY=

# The first parent account. There is no public sign-up: the app is served from
# a public URL, so a sign-up form would let anyone create an account against
# the household. See HAL-1539.
BOOTSTRAP_PARENT_EMAIL=
BOOTSTRAP_PARENT_PASSWORD=
